{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocg:schema:canonical_greenhouse_cluster:0.1.0",
  "type": "object",
  "required": ["iri", "artifact_type", "source_system", "source_id"],
  "properties": {
    "iri": { "type": "string" },
    "artifact_type": { "type": "string", "const": "Cluster" },
    "source_system": { "type": "string" },
    "ingested_at": { "type": ["string", "null"], "format": "date-time" },
    "name": { "type": ["string", "null"] },
    "source_id": { "type": "string" },
    "created_at_source": { "type": ["string", "null"], "format": "date-time" },
    "last_updated_at_source": { "type": ["string", "null"], "format": "date-time" },
    "extensions": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "access_mode": { "type": "string" },
        "mode": { "type": "string" },
        "kubernetes_version": { "type": "string" },
        "nodes_total": { "type": "integer" },
        "nodes_ready": { "type": "integer" },
        "nodes_not_ready": { "type": "array" },
        "bearer_token_expiration": { "type": ["string", "null"], "format": "date-time" },
        "ready": { "type": "string" },
        "conditions": { "type": "array" }
      }
    }
  }
}
