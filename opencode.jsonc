{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // Rules are evaluated by pattern match, with the last matching rule winning
    "bash": {
      "*": "ask",
      // Git
      "git status": "allow",
      "git diff *": "allow",
      // Go
      "go vet *": "allow"
    }
  }
}
