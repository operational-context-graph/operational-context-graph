# OCG Telemetry Store migrator image
#
# Build:
#   docker build -f services/telemetry-store/Dockerfile.migrator \
#     --build-arg VERSION=1.0.0 \
#     -t ghcr.io/operational-context-graph/telemetry-store-migrator:1.0.0 \
#     services/telemetry-store
#
# Required env vars at runtime:
#   DORIS_DSN          MySQL DSN for the Doris FE
#   REPLICATION_NUM    Doris replication_num (default "3"; use "1" for single-BE dev)
#   BUCKETS            Doris bucket count (default "10")

FROM golang:1.27 AS builder

ARG VERSION=dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/telemetry-store-migrator \
    ./cmd/migrate

FROM gcr.io/distroless/static-debian12

COPY --from=builder /out/telemetry-store-migrator /telemetry-store-migrator

USER 1000:1000

ENTRYPOINT ["/telemetry-store-migrator"]
