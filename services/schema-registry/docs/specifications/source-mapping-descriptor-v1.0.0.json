{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Mapping Descriptor v1.0.0",
  "description": "Structural validation for an Operational Context Graph (OCG) source mapping descriptor, format version 1.0.0.",
  "$comment": "Validators MUST enable format assertions for 'uri'. No canonical publication URI is assigned by this schema. Parsers MUST separately reject duplicate member names, invalid UTF-8, and other I-JSON violations. Publishers and importers MUST separately validate schema URI immutability and format compatibility, release dependencies and ancestry, canonical target classes, resource bindings, exact bytes, and revision immutability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "id", "sourceSchema", "engine", "programs"],
  "properties": {
    "$schema": { "$ref": "#/$defs/absoluteUri" },
    "formatVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/logicalType" },
    "sourceSchema": { "$ref": "#/$defs/schemaReference" },
    "engine": { "$ref": "#/$defs/engine" },
    "programs": { "$ref": "#/$defs/programs" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "absoluteUri": {
      "$ref": "#/$defs/nonEmptyString",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:(?:[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=-]|%[0-9A-Fa-f]{2})*$",
      "not": { "pattern": "[\\r\\n\u2028\u2029]" }
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "not": { "pattern": "[\\r\\n\u2028\u2029]" }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha-256:[0-9a-f]{64}$",
      "minLength": 72,
      "maxLength": 72
    },
    "artifactRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]+$",
      "not": { "pattern": "[\\r\\n\u2028\u2029]" },
      "minLength": 1,
      "allOf": [{ "not": { "enum": [".", ".."] } }]
    },
    "logicalType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": { "pattern": "[\\r\\n\u2028\u2029]" }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/logicalType" },
        "revision": { "$ref": "#/$defs/artifactRevision" },
        "version": { "$ref": "#/$defs/schemaVersion" }
      },
      "oneOf": [
        { "required": ["revision"] },
        { "required": ["version"] }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "languageVersion", "executionProfile"],
      "properties": {
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "languageVersion": { "$ref": "#/$defs/schemaVersion" },
        "executionProfile": { "$ref": "#/$defs/nonEmptyString" }
      },
      "$comment": "Language and execution-profile identifiers are publisher-declared metadata, not registered execution capabilities."
    },
    "programReference": {
      "type": "object",
      "required": ["programRef", "programDigest"],
      "properties": {
        "programRef": { "$ref": "#/$defs/nonEmptyString" },
        "programDigest": { "$ref": "#/$defs/digest" }
      },
      "$comment": "Resource names are exact identifiers, not normalized paths. Resource role and digest binding require release context."
    },
    "condition": {
      "$ref": "#/$defs/programReference",
      "unevaluatedProperties": false
    },
    "transformation": {
      "$ref": "#/$defs/programReference",
      "required": ["targetSchema", "cardinality"],
      "properties": {
        "targetSchema": { "$ref": "#/$defs/schemaReference" },
        "cardinality": { "enum": ["one", "many"] }
      },
      "unevaluatedProperties": false
    },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformations"],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transformation" },
          "$comment": "Consumers MUST preserve descriptor order, including repeated program and target references."
        }
      }
    }
  }
}
