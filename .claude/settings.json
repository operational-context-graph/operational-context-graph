{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(git status)", "Bash(git diff --check)", "Bash(git diff --cached --check)", "Bash(sort*)", "Bash(ls*)"],
    "ask": ["Bash(rm *)", "Bash(rmdir *)", "Bash(chmod *)", "Bash(chown *)", "Bash(git clean *)", "Bash(git reset *)", "Bash(git push *)"]
  },
  "plansDirectory": "./.claude/plans"
}
