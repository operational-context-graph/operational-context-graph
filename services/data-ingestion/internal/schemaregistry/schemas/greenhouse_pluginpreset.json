{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocg:schema:greenhouse.PluginPreset:0.1.0",
  "type": "object",
  "required": ["metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "creationTimestamp": { "type": ["string", "null"] }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "plugin": { "type": "object" },
        "clusterSelector": { "type": "object" },
        "deletionPolicy": { "type": "string" }
      }
    },
    "status": { "type": "object" }
  }
}
